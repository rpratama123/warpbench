    {
      "id": "id-cf-cgk",
      "group": "id",
      "name": "Cloudflare edge (nearest colo, typically CGK)",
      "provider": "Cloudflare",
      "protocol": "cloudflare",
      "ping_host": "speed.cloudflare.com",
      "download_url": "https://speed.cloudflare.com/__down",
      "upload_url": "https://speed.cloudflare.com/__up",
      "capabilities": ["ping", "download", "upload", "timings"],
      "tier": "quick",
      "flags": ["footnote:cloudflare-edge"],
      "notes": "Anycast: the colo actually used is read from the trace endpoint and recorded per phase. With WARP enabled this path never leaves Cloudflare's network, so it measures ISP-to-nearest-edge only and must not be read as an end-to-end international result."
    },
